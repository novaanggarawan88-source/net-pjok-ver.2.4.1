rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Real-time synchronization for LMS PJOK records across laptops and smartphones
    match /lms_records/{document=**} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
